{
    "enabledMcpjsonServers": ["cloudflare-docs"],
    "permissions": {
        "allow": [
            "Bash(npm run db:migrate --workspace api)",
            "Bash(npm run probes --workspace api)",
            "Bash(npx wrangler deploy)",
            "Bash(npx wrangler deploy:*)",
            "Bash(npx wrangler d1 migrations apply:*)",
            "Bash(npx wrangler d1 execute:*)",
            "Bash(npx wrangler r2 object put:*)",
            "Bash(npx wrangler tail)",
            "Bash(npx wrangler tail:*)",
            "Bash(npm test)",
            "Bash(npm test:*)",
            "Bash(npm run lint)",
            "Bash(npm run lint:*)",
            "Bash(npm run check)",
            "Bash(npm run agent-docs)",
            "Skill(branch)",
            "Skill(branch:*)",
            "Skill(commit)",
            "Skill(commit:*)",
            "Skill(pr)",
            "Skill(pr:*)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
                        "timeout": 600
                    }
                ]
            }
        ]
    }
}
