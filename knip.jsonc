{
    "$schema": "https://unpkg.com/knip@6/schema.json",

    "workspaces": {
        ".": {
            // Run by the Playwright config's webServer command and by scripts/lint.sh, neither of which knip reads.
            "entry": ["e2e/server.ts", "scripts/check-dependency-versions.ts"],
        },
        "api": {
            // Run directly with node, and inside the transcoder image, rather than imported from anywhere.
            "entry": ["scripts/*.ts", "transcoder/server.ts"],
        },
        "web": {},
        "shared": {},
    },

    "ignoreDependencies": [
        // cloudflare:test and cloudflare:workers are modules of the workerd runtime, not npm packages.
        "cloudflare",
        // Run by scripts/lint.sh, and knip does not read shell scripts.
        "markdownlint-cli2",
    ],

    // System tools, deliberately not npm dependencies (npm run format runs these two)
    "ignoreBinaries": ["shfmt", "tofu"],
}
