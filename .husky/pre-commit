# shellcheck shell=sh
set -e

# Scan for secrets: api/.dev.vars holds real tokens, and one pasted into a file here would be public once pushed.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --no-banner
else
    echo "Warning: gitleaks not installed, skipping secret scan"
    echo "Install with: brew install gitleaks"
fi

# Formats staged files with Prettier, which cannot change what code means. Other fixes stay manual:
# `npm run format` for shell and OpenTofu, `npm run lint:fix` for ESLint, whose fixers sometimes can.
npx lint-staged

# CLAUDE.md and AGENTS.md are generated from docs/AGENTS.src.md, so regenerating them cannot change what anything
# means. After lint-staged, so they are built from the source as Prettier left it. A hand edit to either is caught by
# the lint check below.
if git diff --cached --name-only | grep -qE '^(docs/AGENTS\.src\.md|scripts/build-agent-instructions\.ts)$'; then
    npm run --silent agent-docs
    git add CLAUDE.md AGENTS.md
fi

# The same checks CI runs, scoped to what is staged: per-file lint checks see only staged files, and only the tests
# that import them run. CI runs all of it over the whole repo. Types are always checked across the whole project.
scripts/lint.sh --staged

# The type check and the tests are independent, so they run side by side. The type check's output is held until both
# finish, so the two never interleave.
check_log=$(mktemp)
npm run --silent check >"$check_log" 2>&1 &
check_pid=$!
tests_status=0
scripts/test.sh --staged || tests_status=$?
check_status=0
wait "$check_pid" || check_status=$?
cat "$check_log"
rm -f "$check_log"
[ "$check_status" -eq 0 ] && [ "$tests_status" -eq 0 ]
