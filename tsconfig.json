{
    // The repo's own tooling, run in Node: the lint, format and style configs, and the scripts beside them. api/ and
    // web/ each have their own; each directory's nearest tsconfig.json is the one editors and ESLint use.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        // Reuses the last run's results for files that have not changed.
        "incremental": true,
        "tsBuildInfoFile": "node_modules/.cache/tsc/node.tsbuildinfo",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rewriteRelativeImportExtensions": true,
        "lib": ["es2025"],
        "types": ["node"]
    },
    "include": ["*.ts", "*.mjs", "scripts"]
}
