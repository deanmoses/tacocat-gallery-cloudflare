{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "tacocat-gallery-cloudflare",
    "account_id": "ed3ca575118099486baeb129959697c8",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "tacocat-proto",
            "database_id": "e833562b-4758-41e9-b545-d1aa250bb6c5",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tacocat-proto-media" }],
    "images": { "binding": "IMAGES" },
    "queues": {
        "consumers": [{ "queue": "tacocat-proto-uploads", "max_batch_size": 10, "max_batch_timeout": 1 }],
    },
    "triggers": { "crons": ["17 9 * * *"] },
}
