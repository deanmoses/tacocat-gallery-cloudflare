# The asset router serves the app's files without the Worker, so the headers every response from this site carries are
# repeated here from api/src/http/headers.ts; a stack test fails when the two drift.
/*
  X-Robots-Tag: noindex, noimageindex, nosnippet, max-image-preview:none, notranslate, noarchive, noai, noimageai
  tdm-reservation: 1
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# SvelteKit fingerprints every file under _app/immutable, so a changed file gets a new URL and a browser never needs to
# ask whether its copy is current. The same Cache-Control the AWS site's CloudFront sets on these files.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# A page's headers name the JSON its JS will ask for, so the browser requests it as the headers arrive rather than once
# the app has loaded and run, and with the zone's Early Hints on, before the page's body. `crossorigin` makes the
# preload the same request as the app's fetch(), which a browser matches by mode as well as URL; without it the browser
# fetches twice. A day album's page also fetches its year, where the app finds the previous and next albums. A reader
# arrives from the email at a day album or a photo, so those are the pages that preload.
/:year/:day
  Link: </api/album/:year/:day/>; rel=preload; as=fetch; crossorigin, </api/album/:year/>; rel=preload; as=fetch; crossorigin

/:year/:day/
  Link: </api/album/:year/:day/>; rel=preload; as=fetch; crossorigin, </api/album/:year/>; rel=preload; as=fetch; crossorigin

/:year/:day/:media
  Link: </api/album/:year/:day/>; rel=preload; as=fetch; crossorigin

# A search page's URL has a day album's shape, and a file under images/ or _app/ a photo's; none has an album to
# preload, and a browser acts on a preload in a file's headers as it does on one in a page's.
/search/*
  ! Link

/images/*
  ! Link

/_app/*
  ! Link
