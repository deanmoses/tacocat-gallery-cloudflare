{
    "name": "@tacocat-gallery/web",
    "version": "0.0.1",
    "private": true,
    "description": "SvelteKit front end for the Tacocat photo gallery",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepare": "svelte-kit sync"
    },
    "dependencies": {
        "@simplewebauthn/browser": "^14.0.0",
        "@tacocat-gallery/shared": "*",
        "idb-keyval": "^6.3.0",
        "quill": "^2.0.3",
        "svelte-dnd-action": "^0.9.80",
        "svelte-easy-crop": "^5.0.1"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@vitest/browser-playwright": "^5.0.5",
        "@vitest/coverage-istanbul": "^5.0.5",
        "@zerodevx/svelte-toast": "^0.9.6",
        "browserslist-to-esbuild": "^2.1.1",
        "eslint": "^10.13.0",
        "eslint-plugin-es-x": "^10.1.0",
        "fake-indexeddb": "^6.2.6",
        "playwright": "1.64.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24.2.0 <25"
    }
}
