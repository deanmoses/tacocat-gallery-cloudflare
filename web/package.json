{
    "name": "tacocat-gallery-web",
    "version": "0.0.1",
    "description": "SvelteKit front end for the pix.tacocat.com photo gallery",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.service-worker.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepare": "svelte-kit sync"
    },
    "dependencies": {
        "idb-keyval": "^6.3.0",
        "immer": "^11.1.18",
        "quill": "^2.0.3",
        "svelte-easy-crop": "^5.0.1",
        "tacocat-gallery-shared": "0.0.1"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@vitest/browser-playwright": "^5.0.1",
        "@vitest/coverage-istanbul": "^5.0.1",
        "@zerodevx/svelte-toast": "^0.9.6",
        "fake-indexeddb": "^6.2.5",
        "playwright": "1.63.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "~6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "engines": {
        "node": ">=24.2.0 <25"
    }
}
