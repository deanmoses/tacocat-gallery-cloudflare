{
    // Rules live in .markdownlint.jsonc so the editor extension reads them too.
    "globs": ["**/*.md"],
    "ignores": [
        ".git",
        "**/node_modules",
        ".wrangler",
        "infra/.terraform",
        // Generated from docs/AGENTS.src.md; linting them duplicates linting the source.
        "CLAUDE.md",
        "AGENTS.md",
    ],
}
