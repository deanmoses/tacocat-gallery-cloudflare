{
    "name": "tacocat-gallery-cloudflare",
    "version": "0.0.1",
    "description": "The pix.tacocat.com photo gallery on Cloudflare",
    "workspaces": [
        "shared",
        "api",
        "web"
    ],
    "scripts": {
        "test": "scripts/test.sh",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:coverage": "npm run --silent test:coverage --workspace api --workspace web",
        "check": "tsc -p . && tsc -p e2e && npm run --silent check --workspaces",
        "lint": "scripts/lint.sh",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write --log-level warn . && shfmt --write scripts api/scripts .claude/hooks .husky/pre-commit .husky/commit-msg && tofu -chdir=infra fmt -recursive",
        "quality": "npm run format && npm run lint && npm run check && npm test",
        "prepare": "husky && playwright install chromium",
        "agent-docs": "node scripts/build-agent-instructions.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.0",
        "@playwright/test": "1.63.0",
        "@types/node": "^24.13.6",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-es-x": "^10.0.1",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-regexp": "^3.3.1",
        "eslint-plugin-svelte": "^3.23.0",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "knip": "^6.37.0",
        "lint-staged": "^17.5.1",
        "markdownlint-cli2": "^0.23.3",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "stylelint": "^17.15.0",
        "stylelint-config-html": "^2.0.0",
        "stylelint-config-standard": "^40.0.0",
        "tacocat-gallery-shared": "0.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    },
    "private": true,
    "engines": {
        "node": ">=24.2.0 <25"
    },
    "lint-staged": {
        "*.{ts,mjs,js,svelte,css,html,json,jsonc,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
