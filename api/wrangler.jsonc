{
    "$schema": "../node_modules/wrangler/config-schema.json",
    // Two environments, each its own Worker with its own data. The top level is staging, which is also what
    // `wrangler dev` and the tests run locally, so a Wrangler command without --env can only reach staging;
    // `--env production` is the only way to production. Bindings are not inherited, so each environment lists its own.
    "name": "tacocat-gallery-cloudflare-staging",
    "account_id": "ed3ca575118099486baeb129959697c8",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    // Stack traces in logs and `wrangler tail` point at the TypeScript source instead of the bundle.
    "upload_source_maps": true,
    "assets": {
        // The SvelteKit app's build. The dev and deploy scripts in package.json rebuild it first; a bare `wrangler
        // deploy` ships whatever is there. Wrangler's `build` option would rebuild it too, but `wrangler types` runs
        // that as well, so a type check running beside the tests rewrote the files the tests were serving.
        "directory": "../web/build",
        "binding": "ASSETS",
        // Paths the app routes in the browser (/2001/06-15) have no file, so they get the app's index.html.
        "not_found_handling": "single-page-application",
        // Every path the Worker serves, and only those; the rest are the app's files. Once this is a list, a request it
        // does not match never reaches the Worker, navigation or not, so a new route here has to be added to it.
        "run_worker_first": [
            "/api/*",
            "/login",
            "/invite/*",
            "/raw/*",
            "/v/*",
            "/i/*",
            "/i2/*",
            "/debug/*",
            "/upload/*",
        ],
    },
    // Adding `routes` switches workers.dev off unless this is set, and preview URLs only exist on workers.dev.
    "workers_dev": true,
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Transcoder"] }],
    "secrets": {
        "required": [
            "R2_ACCESS_KEY_ID",
            "R2_SECRET_ACCESS_KEY",
            "GLOBALPING_TOKEN",
            "SESSION_SECRET",
            "DEBUGBEAR_API_KEY",
        ],
    },
    "routes": [{ "pattern": "staging-pix.deanmoses.com", "custom_domain": true }],
    "vars": {
        // The site's own origin, the only one besides local development that may create or use a passkey.
        "SITE_ORIGIN": "https://staging-pix.deanmoses.com",
        // The derived bucket's custom domain, which /i2/* fetches derivatives through.
        "DERIVED_ORIGIN": "https://staging-img.deanmoses.com",
        // The buckets by their S3 names: uploads are presigned into the first, and the transcoder writes into the second.
        "MEDIA_BUCKET": "tacocat-staging-media",
        "DERIVED_BUCKET": "tacocat-staging-derived",
        // What the idle-latency probes measure.
        "PROBE_TARGET": "tacocat-gallery-cloudflare-staging.tacocat-gallery-cloudflare.workers.dev",
        // Where the browser puts an upload: "signed" is a presigned URL into the media bucket, whose event R2 sends to
        // the queue. A local Worker can consume no real queue, so `wrangler dev` sets this to "local" in .dev.vars
        // and the Worker takes the PUT itself, into its local bucket, and raises the event.
        "UPLOADS": "signed",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "tacocat-staging",
            "database_id": "55f1fb52-b6df-497d-8beb-403e91dd0466",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "tacocat-staging-media" },
        { "binding": "DERIVED", "bucket_name": "tacocat-staging-derived" },
    ],
    "images": { "binding": "IMAGES" },
    // The running version's id, which /api/health answers with so a release can prove its check reached the new code.
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "queues": {
        // The producer is for local uploads only; deployed, R2's event notification is the producer.
        "producers": [{ "binding": "UPLOAD_EVENTS", "queue": "tacocat-staging-uploads" }],
        "consumers": [
            {
                "queue": "tacocat-staging-uploads",
                "max_batch_size": 10,
                "max_batch_timeout": 1,
                "max_retries": 5,
                // Seconds, so a short D1 or R2 outage can pass before the next attempt.
                "retry_delay": 60,
                // Messages that run out of retries are kept here for replay instead of being dropped.
                "dead_letter_queue": "tacocat-staging-uploads-dlq",
            },
        ],
    },
    "triggers": {
        "crons": [
            // Daily D1 backup and upload-error purge. src/index.ts picks the job by this exact string (BACKUP_CRON), so change both together.
            "17 9 * * *",
        ],
    },
    "containers": [
        {
            "class_name": "Transcoder",
            "image": "./transcoder/Dockerfile",
            "instance_type": "lite",
            "max_instances": 1,
        },
    ],
    "durable_objects": { "bindings": [{ "name": "TRANSCODER", "class_name": "Transcoder" }] },
    "env": {
        "production": {
            // The Worker's original name, so its custom domain, secrets, container and probe history stay where they are.
            "name": "tacocat-gallery-cloudflare",
            "secrets": {
                "required": [
                    "R2_ACCESS_KEY_ID",
                    "R2_SECRET_ACCESS_KEY",
                    "GLOBALPING_TOKEN",
                    "SESSION_SECRET",
                    "DEBUGBEAR_API_KEY",
                ],
            },
            "routes": [{ "pattern": "pix.deanmoses.com", "custom_domain": true }],
            "vars": {
                "SITE_ORIGIN": "https://pix.deanmoses.com",
                "DERIVED_ORIGIN": "https://img.deanmoses.com",
                "MEDIA_BUCKET": "tacocat-proto-media",
                "DERIVED_BUCKET": "tacocat-proto-derived",
                "PROBE_TARGET": "tacocat-gallery-cloudflare.tacocat-gallery-cloudflare.workers.dev",
                "UPLOADS": "signed",
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "tacocat-proto",
                    "database_id": "e833562b-4758-41e9-b545-d1aa250bb6c5",
                    "migrations_dir": "migrations",
                },
            ],
            "r2_buckets": [
                { "binding": "MEDIA", "bucket_name": "tacocat-proto-media" },
                { "binding": "DERIVED", "bucket_name": "tacocat-proto-derived" },
            ],
            "images": { "binding": "IMAGES" },
            "version_metadata": { "binding": "CF_VERSION_METADATA" },
            "queues": {
                "producers": [{ "binding": "UPLOAD_EVENTS", "queue": "tacocat-proto-uploads" }],
                "consumers": [
                    {
                        "queue": "tacocat-proto-uploads",
                        "max_batch_size": 10,
                        "max_batch_timeout": 1,
                        "max_retries": 5,
                        "retry_delay": 60,
                        "dead_letter_queue": "tacocat-proto-uploads-dlq",
                    },
                ],
            },
            "triggers": {
                "crons": [
                    "17 9 * * *",
                    // Idle-latency probes (src/ops/probes.ts) at doubling gaps; src/index.ts runs these for every cron it does
                    // not pick by name.
                    // Production only: they measure the site readers use.
                    "23 0,1,3,7,15 * * *",
                    // DebugBear browser runs of every page (src/ops/browser-runs.ts), cold then warm fifteen minutes later,
                    // two hours from every probe run so neither finds the site just warmed by the other. src/index.ts
                    // picks the run by these exact strings, so change both together.
                    "23 5,11,19,22 * * *",
                    "38 5,11,19,22 * * *",
                ],
            },
            "containers": [
                {
                    "class_name": "Transcoder",
                    // The container application's default name ends in the environment's, so the one that exists is
                    // named here.
                    "name": "tacocat-gallery-cloudflare-transcoder",
                    "image": "./transcoder/Dockerfile",
                    "instance_type": "lite",
                    "max_instances": 1,
                },
            ],
            "durable_objects": { "bindings": [{ "name": "TRANSCODER", "class_name": "Transcoder" }] },
        },
    },
}
